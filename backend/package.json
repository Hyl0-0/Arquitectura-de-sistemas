{
  "name": "alumco-backend-serverless",
  "version": "1.0.0",
  "description": "Backend Serverless en Node.js para Alumco y organizaciones multi-tenant con Clean Architecture y AWS DynamoDB",
  "main": "src/frameworks/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/frameworks/server.js",
    "dev": "node --watch src/frameworks/server.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-sqs": "^3.750.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0"
  }
}
